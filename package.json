{
  "name": "local-tex-web-editor",
  "version": "0.1.17",
  "private": true,
  "type": "module",
  "description": "A local LaTeX editor with a browser interface, TeX Live compilation, PDF and Markdown previews",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:windows-resources": "node scripts/build-windows-resources.mjs",
    "test": "playwright test --config tests/playwright.config.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:ui": "playwright test --config tests/playwright.config.mjs",
    "build:msix": "node scripts/build-msix.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2",
    "dompurify": "3.4.18",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "markdown-it-cjk-friendly": "3.0.0",
    "markdown-it-texmath": "1.0.0",
    "pdfjs-dist": "6.5.438",
    "prosemirror-commands": "1.7.2",
    "prosemirror-inputrules": "1.7.0",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.14.0",
    "prosemirror-model": "1.25.13",
    "prosemirror-schema-list": "1.6.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-view": "1.43.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
